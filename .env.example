SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
HTTPS_ENABLED=False
DJANGO_BIND_ADDR=127.0.0.1
AIRFLOW_BIND_ADDR=127.0.0.1
AIRFLOW_HOST_PORT=8080
AIRFLOW_FERNET_KEY=


SQLSERVER_DATABASE=
SQLSERVER_HOST=
SQLSERVER_PORT=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_TRUST_SERVER_CERTIFICATE=

AIRFLOW_UID=
AIRFLOW_POSTGRES_USER=
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_POSTGRES_DB=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# Gửi ZNS qua Incom Omni. Mặc định dry_run = KHÔNG gửi tin thật; chỉ đặt live khi đã sẵn sàng gửi cho khách.
ZNS_SEND_MODE=dry_run
ZNS_API_URL=https://omni.incom.vn/api/OmniMessage/SendMessage
ZNS_ROUTE_RULE=1
ZNS_PGI_USERNAME=
ZNS_PGI_PASSWORD=
ZNS_AWG_USERNAME=
ZNS_AWG_PASSWORD=
ZNS_SEND_DELAY_MS=300
ZNS_API_TIMEOUT=20
ZNS_RETRY_DELAYS=2,5
ZNS_PAUSE_AFTER=5
ZNS_MAX_MANUAL_RETRIES=3
# Lô đang gửi im quá số giây này thì web server tự chạy tiếp (phải lớn hơn thời gian gửi một khách lâu nhất)
ZNS_RESUME_AFTER_SECONDS=180
ZNS_WATCH_INTERVAL_SECONDS=60
# Dừng lâu hơn số giây này thì không tự gửi tiếp: lô chuyển Tạm dừng để người dùng xử lý
ZNS_RESUME_MAX_SECONDS=7200
# Tự chạy tiếp tối đa chừng này lần mỗi lô, quá thì tạm dừng
ZNS_MAX_AUTO_RESUMES=3
# Chừng này khách liên tiếp đều lỗi thì tạm dừng lô
ZNS_PAUSE_AFTER_ERRORS=20
