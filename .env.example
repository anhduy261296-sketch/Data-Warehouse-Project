ZNS_API_URL=https://omni.incom.vn/api/OmniMessage/SendMessage
ZNS_ROUTE_RULE=1
ZNS_PGI_USERNAME=
ZNS_PGI_PASSWORD=
ZNS_AWG_USERNAME=
ZNS_AWG_PASSWORD=
ZNS_SEND_DELAY_MS=300
